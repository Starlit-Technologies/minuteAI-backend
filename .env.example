# Production database
# Use your Supabase Postgres connection string here.
# Render should set this as a secret env var, not commit the real value.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Local development can omit DATABASE_URL.
# When omitted, MinuteAI uses storage/minuteai.db for local SQLite only.

ANTHROPIC_API_KEY=
GROQ_API_KEY=
WHISPER_BACKEND=groq
WHISPER_MODEL=turbo

APP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

JWT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

GOOGLE_CLIENT_ID=
