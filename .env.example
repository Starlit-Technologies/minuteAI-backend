# Required
ANTHROPIC_API_KEY=your_anthropic_key_here

# Auth — JWT secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Email — get a free key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Frontend URL (used in email links)
APP_URL=http://localhost:5173

# Whisper backend — controls transcription
# "local"  → free, runs on your machine (default, good for dev)
# "groq"   → free API, 10x faster, best for production hosting
WHISPER_BACKEND=local

# Only needed when WHISPER_BACKEND=groq
# Get a free key at console.groq.com
GROQ_API_KEY=

# Local Whisper model size (only used when WHISPER_BACKEND=local)
# Options: tiny, base, small, medium, large-v3, turbo (default)
WHISPER_MODEL=turbo
