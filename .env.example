# Production database
# Use your Supabase Postgres connection string here.
# Render should set this as a secret env var, not commit the real value.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Local development can omit DATABASE_URL.
# When omitted, MinuteAI uses storage/minuteai.db for local SQLite only.

ANTHROPIC_API_KEY=
GROQ_API_KEY=
WHISPER_BACKEND=groq
WHISPER_MODEL=turbo

APP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

JWT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

GOOGLE_CLIENT_ID=

# ── Cloudflare R2 (persistent audio & document storage) ──────────────────────
# Get these from the Cloudflare dashboard → R2 → Manage R2 API tokens
# Leave blank to use local disk only (development mode).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=minutesai-audio
# Optional: public bucket URL (e.g. https://pub-xxxx.r2.dev)
# If unset, presigned URLs are used for downloads (recommended).
R2_PUBLIC_URL=

# ── Transcription backend ─────────────────────────────────────────────────────
# Options: groq (default, fast) | assemblyai (diarization, speaker labels)
TRANSCRIPTION_BACKEND=groq
ASSEMBLYAI_API_KEY=
# Optional: hint the number of speakers to improve diarization accuracy
ASSEMBLYAI_SPEAKERS_EXPECTED=

# ── Translation backend ─────────────────────────────────────────────────
# Options: auto (default) | deepl | claude
# auto = try DeepL first (30 supported languages), fall back to Claude
TRANSLATION_BACKEND=auto
# DeepL Free tier: 500,000 chars/month free. https://www.deepl.com/pro-api
DEEPL_API_KEY=

# ── Deepgram (real-time live transcription via WebSocket) ────────────────
# Free tier: $200 credits (~46,500 mins). https://console.deepgram.com
# Required for /ws/live-translate WebSocket endpoint.
DEEPGRAM_API_KEY=
